{
  "name": "vibeguard-ai",
  "displayName": "VibeGuard AI",
  "description": "AI-powered code security scanner for VS Code with static analysis, sandbox execution, risk scoring, and AI-assisted vulnerability detection.",
  "version": "0.0.1",
  "publisher": "vibe-guard-team",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/rugdesai/AiGuardrail.git"
  },
  "bugs": {
    "url": "https://github.com/rugdesai/AiGuardrail/issues"
  },
  "homepage": "https://github.com/rugdesai/AiGuardrail",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Testing"
  ],
  "keywords": [
    "security",
    "code security",
    "vulnerability",
    "static analysis",
    "sandbox",
    "AI security",
    "security scanner",
    "secure coding",
    "code analysis"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vibeguard.scanAndRun",
        "title": "Vibe-Guard: Scan & Run",
        "icon": "$(shield)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "vibeguard.scanAndRun",
          "group": "navigation",
          "when": "editorHasSelection || resourceExtname == .py || resourceExtname == .js"
        }
      ],
      "editor/title": [
        {
          "command": "vibeguard.scanAndRun",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vibeguard.scanAndRun",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.0.0"
  }
}
